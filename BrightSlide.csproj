<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BrightSlide</AssemblyName>
    <RootNamespace>BrightSlide</RootNamespace>
    <Product>BrightSlide</Product>
    <Description>드래그 한 번으로 모니터 밝기를 조절하는 Windows 전용 트레이 유틸리티</Description>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Version>0.2.2</Version>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>Assets\brightslide.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\brightslide.ico" LogicalName="BrightSlide.Assets.brightslide.ico" />
  </ItemGroup>

</Project>
