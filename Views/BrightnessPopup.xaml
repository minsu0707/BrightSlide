<Window x:Class="BrightSlide.Views.BrightnessPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="밝기 조절"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Deactivated="OnDeactivated">
    <Border Background="#E6202020"
            CornerRadius="10"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="18"
            MinWidth="280">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="디스플레이 밝기"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           Foreground="#CCFFFFFF" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0}%}"
                                           Foreground="#CCFFFFFF" FontSize="12" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="감지된 디스플레이가 없습니다"
                       Foreground="#99FFFFFF" FontSize="12"
                       Visibility="{Binding HasNoDevicesVisibility}" />
        </StackPanel>
    </Border>
</Window>
